{
  // Immersive Romance Framework: the numbers. Every value here is the built-in default; change any of them, or delete
  // a line to keep the default. Approval runs 0..100. Days are game days. Distances are game units (~70 = 1 m).

  // Systems on or off. Off, the framework leaves that part of the game alone. A modlist keeps its own changes in
  // Rules.user.json beside this file (only the keys it changes), so a framework update's new defaults still come through.
  "systems": {
    "jealousy": true,        // she gets jealous of another woman at your side
    "crimes": true,          // crimes she sees cost (or earn) approval, with her line
    "murderLeaves": true,    // a good-hearted one leaves you over a murder (murderLeaveAlignment below)
    "absence": true,         // a long time apart costs approval
    "bleedouts": true,       // going down at your side costs approval
    "exposeScenes": true,    // two partners have it out (off: both simply catch you)
    "familyTalks": true,     // she and an adopted child talk at home
    "stayHome": true,        // a wife with children won't leave town with you
    "confession": true,      // at the commitment bar she comes to tell you how she feels, and that makes her Committed (off: at once)
    "serviceRefusal": true,  // her family or friends refuse you their shop or training over a broken heart
    "roadLines": true        // her lines on the road (places, after a fight, dragons, resting)
  },

  // Who the player is interested in: "any", "male" or "female" (eXrim's character creator overrides this)
  "playerInterestedIn": "any",

  // stages
  "startApproval": 20,      // when someone becomes a Friend
  "askDateApproval": 35,    // a Friend says yes to "Would you spend an evening with me?" from this much (and hints at it)
  "standUpCost": 10,        // you didn't come to the first date
  "firstDateDistance": 1000.0, // she's this close to her spot after sunset: talk to her for the date
  "dateStrayDistance": 1500.0, // walking her home: this far from her and you're turned back toward her
  "dateHomeDistance": 600.0,   // ... and this close to her door, she stops you there
  "mineApproval": 30,          // after a goodnight at her door, "Will you be mine?" while approval is at least this
  "commitBar": 75,          // Dating -> Committed from this, once she tells you (her confession)
  "uncommitBar": 60,        // Committed -> back to Dating below this (the leeway: one bad fight doesn't undo it)
  "floorDating": 1,         // below this from Dating up, they end it

  // what raises approval
  "knowGain": 3,            // a question you hadn't asked her yet ("I'd like to get to know you better.", one a day)
  "dateGain": 3,            // "Spend the evening with me." (evenings, from Dating up) ...
  "dateFromHour": 18.0,     // ... from this hour to dateToHour, in a town (a city, town, settlement, inn or home), not in combat
  "dateToHour": 22.0,
  "eveningHours": 2.0,      // ... the screen fades, this many hours pass, and you're both outside the town's inn (or her home)
  "dateEveryDays": 2.0,     // ... offered this often: the road together is where approval grows
  "kissGain": 1,            // the first kiss of the day (kiss as often as you like)
  "wifeGiftEveryDays": 3.0, // married, she takes a gift again, this often (Dating to Engaged she declines them)
  "giftGain": 3,            // a gift (one a day: the line waits until a day has passed)
  "giftLikedGain": 5,       // a gift they like, instead
  "giftLovedGain": 8,       // a gift they love, instead
  "giftDislikedCost": 3,    // a gift they dislike
  "giftInsultCost": 15,     // a gift they take as an insult (a human heart); they won't take it
  "giftGoldLiked": 10,      // gold: less than this they dislike, from this they like ...
  "giftGoldLoved": 300,     // ... and from this they love
  "killGain": 1,            // an enemy killed while they follow ...
  "killCapPerDay": 5,       // ... up to this many a day
  "clearGain": 5,           // a location cleared together

  // what lowers it (defaults; each candidate's own tolerances override these)
  "bleedoutCost": 8,        // one bleedout while following you (until the wedding); a rescue gives nothing back
  "cheatCost": 30,          // being caught straying
  "brokenHeartDays": 3,     // silent this long after being caught, then hurt until amends
  "hitCost": 2,             // a stray hit in a fight
  "strayHitsToAttack": 4,   // this many stray hits in one fight count as an attack
  "attackCost": 25,         // an attack
  "attackLockDays": 3,      // won't follow or date after an attack
  "absence1": 3,            // apart longer than this many days hurts (band 1) ...
  "absence2": 6,            // ... more (band 2) ...
  "absence3": 10,           // ... most (band 3)
  "absenceCost": 5,         // ... this much per band (1-3), once, when you meet again
  "jealousCost": 2,         // seen travelling with another woman, once a day
  "waryDays": 5,            // her wary mood after an attack (a candidate's "wary" days override it)

  // her moods (for her greetings, goodbyes and idles)
  "jealousDays": 1,         // jealous for the rest of that day (1) or more

  // approval bands, where each starts (band 1 from 0): her "How are we?" answer, and how things are at home for the
  // children's greetings and family talks (bands 4 and 5 happy, 3 fine, 2 strained, 1 bad). Below band3 she's
  // strained (her mood); below band2 things are bad and her spouse perk pauses
  "band2": 25,
  "band3": 50,
  "band4": 70,
  "band5": 85,

  // her heartbreak when you end it (a candidate's "heartbreak" overrides these)
  "heartbreakSilentDays": 5, // bitter: won't talk to you this long (also when she catches you)
  "pleads": 3,              // pleading: asks you back this many times ...
  "pleadEvery": 2,          // ... this many days apart
  "crimeScale": 1,          // a crime they see: alignment x severity x this (theft 1, pickpocket 2, assault 4, murder 10)
  "murderLeaveAlignment": 2, // a murder she sees, her alignment this or higher: she turns wary (her waryDays), stops
                             // following and goes home, and won't come along again for her attackLockDays

  // breakups and reactions
  "winBackDays": 7,         // after a breakup, "Could we try again?" works after this many days
  "winBackApproval": 15,    // approval they start from when they take you back
  "amendsApproval": 0,      // added when amends are made
  "reactionDays": 7,        // a reaction line waiting for your next meeting expires after this
  "garrulousScale": 100,    // a witness's garrulous (0..100) times this / 100 is the chance word gets back

  // a partner fighting beside you grows like you do
  "partnerXpPerLevel": 100,
  "partnerXpKill": 10,      // per kill, times the enemy's level / 10 (at least 1)
  "partnerXpClear": 50,     // a location cleared together
  "partnerHealthPerLevel": 10,
  "partnerSkillPerLevel": 2,

  // becoming Committed: she comes up to you and says how much you mean to her; when that talk ends she is Committed
  "confessDelayDays": 1.0,   // this long after her approval reaches commitBar (still Dating until she has said it) ...
  "confessMinDatingDays": 3.0, // ... and not before you've been Dating this long (since the first date or a win-back;
                               // a candidate's "confession": { "minDatingDays" } overrides it)
  "confessDistance": 3000.0, // when you're this close, somewhere safe, out of combat

  // adopted children
  "childAway1": 3,          // a child misses you after this many days apart (their "away1" greeting) ...
  "childAway2": 6,          // ... more so after this many ("away2") ...
  "childAway3": 10,         // ... and most after this many ("away3")

  // lines and sight
  "momentCooldownSeconds": 90.0,  // between two road lines
  "witnessDistance": 2048.0,      // farther than this, nobody saw it
  "caughtDistance": 2048.0,       // your partner sees you stray within this
  "jealousDistance": 1536.0,      // your partner sees you and her within this
  "exposeDistance": 1024.0,       // another partner this close hears one greet you as hers: both catch you
  "caughtLineGap": 4.0,           // seconds between two partners' caught lines in one scene
  "exposeLeaveDistance": 4096.0,  // when two partners have it out: walk this far off and it's broken off
  "exposePersuade": 50,           // ... the Speech that carries your lie (fixed)
  "exposeDoubtCost": 5,           // ... approval the one who believed you still loses
  "disownedSpouseMult": 3,        // ... a wife you denied: her broken heart lasts this many times as long
  "familyHearDistance": 1500.0    // a family conversation: she and a child this close to each other and to you
}
